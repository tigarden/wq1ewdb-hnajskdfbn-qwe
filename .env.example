# =======================================================
# Debet.auto — Настройки базы данных и безопасности
# =======================================================

# 1. Строка подключения к базе данных (DATABASE_URL)
# -------------------------------------------------------
# А) Для локального PostgreSQL через Docker или установленного на ПК:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/debet
#
# Б) Для облачного PostgreSQL (Supabase / Neon / Render / Timeweb):
# DATABASE_URL=postgresql+asyncpg://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?ssl=require
#
# В) Для локального файла SQLite (fallback / локальная разработка без поднятого сервера):
DATABASE_URL=sqlite+aiosqlite:///./debet.db

# 2. Безопасность и авторизация
# -------------------------------------------------------
# Секретный ключ для подписи токенов JWT (смените на случайный в продакшене)
SECRET_KEY=debet-auto-super-secure-master-secret-key-2026-xyz789

# Срок действия авторизации в минутах (10080 минут = 7 дней / 1 неделя)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Мастер-пароль по умолчанию (PIN)
MASTER_PASSWORD=010700GkO

# 3. Разрешенные CORS источники (Frontend Vite & GitHub Pages)
# -------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://tigarden.github.io"]
